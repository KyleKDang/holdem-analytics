# Database Configuration
# The +asyncpg dialect is required: the app uses create_async_engine.
# Running under Docker Compose, the host is the service name `db`, not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/poker_analytics

# Security / JWT
# Required. Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Go odds engine
GO_SERVICE_URL=http://localhost:8001

# Extra allowed CORS origin (http://localhost:3000 is always allowed)
FRONTEND_URL=

# App Configuration
# True enables SQLAlchemy statement echo.
DEBUG=False
